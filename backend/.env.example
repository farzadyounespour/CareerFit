DJANGO_SECRET_KEY=replace-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://127.0.0.1:5173
DATABASE_URL=sqlite:///db.sqlite3
# Production defaults become secure automatically when DJANGO_DEBUG=False.
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SESSION_COOKIE_SECURE=True
# DJANGO_CSRF_COOKIE_SECURE=True
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# DJANGO_SECURE_HSTS_PRELOAD=True
ADZUNA_APP_ID=your_app_id
ADZUNA_APP_KEY=your_rotated_app_key
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
CAREERFIT_ENABLE_LLM=False
OPENAI_TIMEOUT_SECONDS=20
OPENAI_MAX_OUTPUT_TOKENS=700
OPENAI_MAX_RETRIES=1
CAREERFIT_ANON_RATE=120/hour
CAREERFIT_USER_RATE=1000/hour
CAREERFIT_LLM_RATE=10/hour
CAREERFIT_TOKEN_TTL_HOURS=168
# Configure SMTP for production account emails.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=CareerFit <noreply@careerfit.local>
